rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      // 知道家庭碼才讀得到（不能列出所有家）
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);
      // 成員可以更新；非成員只能「把自己加進去」且一個家最多兩人
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.members.keys().hasAll(resource.data.members.keys())
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= 2
          && request.resource.data.dog == resource.data.dog)
      );

      match /events/{id} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.members;
      }
    }
  }
}
